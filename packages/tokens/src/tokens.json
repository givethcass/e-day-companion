    },
    "overline": {
      "font": "mono",
      "weight": 600,
      "size": 12,
      "lineHeight": 1.3,
      "letterSpacing": 1.4,
      "case": "upper"
    },
    "data": {
      "font": "mono",
      "weight": 500,
      "size": 14,
