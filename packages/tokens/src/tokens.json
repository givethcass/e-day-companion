{
  "$description": "Direction A, \"COG Command\": crimson and gunmetal on near-black, condensed display type, HUD corner marks, no gradients. Dark only.",
  "color": {
    "bg": "#111315",
    "surface": "#1B1E22",
    "surfaceRaised": "#24282E",
    "border": "#2E333A",
    "text": "#ECEAE6",
    "textMuted": "#A3A7AD",
    "textSubtle": "#8A8F96",
    "primary": "#B8321F",
    "onPrimary": "#FFFFFF",
    "accent": "#E8604C",
    "highlight": "#E3A33B",
    "onHighlight": "#111315",
    "disabled": "#3A3F46"
  },
  "font": {
    "display": "Barlow Condensed",
    "body": "IBM Plex Sans"
  },
  "type": {
    "display": { "font": "display", "weight": 700, "size": 30, "lineHeight": 1.0, "letterSpacing": 1, "case": "upper" },
    "headline": { "font": "display", "weight": 700, "size": 27, "lineHeight": 1.05, "case": "upper" },
    "section": { "font": "display", "weight": 700, "size": 19, "lineHeight": 1.2, "letterSpacing": 1, "case": "upper" },
    "stat": { "font": "display", "weight": 700, "size": 26, "lineHeight": 1.0 },
    "bodyStrong": { "font": "body", "weight": 600, "size": 14, "lineHeight": 1.4 },
    "body": { "font": "body", "weight": 400, "size": 13, "lineHeight": 1.45 },
    "caption": { "font": "body", "weight": 400, "size": 12, "lineHeight": 1.4 },
    "overline": { "font": "body", "weight": 600, "size": 11, "lineHeight": 1.3, "letterSpacing": 1.6, "case": "upper" },
    "legal": { "font": "body", "weight": 400, "size": 10.5, "lineHeight": 1.4 }
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 28 },
  "radius": { "chip": 6, "button": 10, "card": 12, "hero": 14, "avatar": 999 },
  "size": { "touchTarget": 44, "button": 46, "icon": 22, "tabBar": 76 },
  "contrast": {
    "$description": "Pairs used for text in the designs. Each must reach WCAG AA (4.5:1).",
    "text": [
      ["text", "bg"], ["text", "surface"], ["text", "surfaceRaised"], ["text", "disabled"],
      ["textMuted", "bg"], ["textMuted", "surface"],
      ["textSubtle", "bg"], ["textSubtle", "surface"],
      ["accent", "bg"], ["accent", "surface"],
      ["highlight", "surface"], ["highlight", "surfaceRaised"],
      ["onPrimary", "primary"], ["onHighlight", "highlight"]
    ]
  }
}
