{
  "$description": "Direction C, the look of the official Gears of War site (chosen 2026-10-28): black, a deep red band that fades to black, solid red buttons with white text, condensed uppercase titles in Barlow Condensed, Barlow for body, square corners. Colours measured from a capture of gearsofwar.com; the accent red is nudged from #E43127 to #F0473A so red text passes AA on surfaces. Dark only. Directions A and B are kept in tokens-a.json and tokens-b.json for the record.",
  "color": {
    "bg": "#000000",
    "surface": "#0E0E0E",
    "surfaceRaised": "#161616",
    "border": "#262626",
    "band": "#800000",
    "text": "#FFFFFF",
    "textMuted": "#B4B2B2",
    "textSubtle": "#959393",
    "textFaint": "#8A8888",
    "primary": "#F0473A",
    "onPrimary": "#000000",
    "accent": "#F0473A",
    "highlight": "#F0473A",
    "onHighlight": "#000000",
    "action": "#BF0A0A",
    "onAction": "#FFFFFF",
    "danger": "#FF6B5B",
    "disabled": "#2A2A2A"
  },
  "font": {
    "display": "Barlow Condensed",
    "body": "Barlow",
    "mono": "Barlow Condensed"
  },
  "type": {
    "display": {
      "font": "display",
      "weight": 700,
      "size": 32,
      "lineHeight": 1.0,
      "case": "upper"
    },
