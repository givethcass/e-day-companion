    "button": {
      "font": "mono",
      "weight": 700,
      "size": 15,
      "lineHeight": 1.2,
      "letterSpacing": 0.8,
      "case": "upper"
    },
    "legal": {
      "font": "body",
      "weight": 400,
      "size": 11,
      "lineHeight": 1.4
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 28
  },
  "radius": {
    "chip": 0,
    "button": 0,
    "card": 0,
    "hero": 0,
    "avatar": 999
  },
  "size": {
    "touchTarget": 44,
    "button": 44,
    "icon": 22,
    "tabBar": 76,
    "heroRule": 3
