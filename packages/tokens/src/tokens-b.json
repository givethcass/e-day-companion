      "size": 11,
      "lineHeight": 1.3,
      "letterSpacing": 1,
      "case": "upper"
    },
    "stat": {
      "font": "mono",
      "weight": 600,
      "size": 24,
      "lineHeight": 1.1
    },
    "bodyStrong": {
      "font": "body",
      "weight": 600,
      "size": 14,
      "lineHeight": 1.4
    },
    "body": {
      "font": "body",
      "weight": 400,
      "size": 13,
      "lineHeight": 1.45
    },
    "caption": {
      "font": "body",
      "weight": 400,
      "size": 12,
      "lineHeight": 1.4
    },
    "overline": {
      "font": "mono",
      "weight": 400,
      "size": 11,
      "lineHeight": 1.3,
      "letterSpacing": 1,
      "case": "upper"
    },
    "data": {
      "font": "mono",
      "weight": 400,
      "size": 12,
      "lineHeight": 1.4
