{
  "$description": "Direction B, \"Tactical HUD\" (chosen and then replaced by direction C on 2026-10-28; kept for the record): amber on near-black, condensed uppercase titles, monospaced numbers and labels, log-style rows, square corners. Dark only. Direction A is kept in tokens-a.json for the record.",
  "color": {
    "bg": "#0B0C0D",
    "surface": "#131517",
    "surfaceRaised": "#1B1E21",
    "border": "#23262A",
    "text": "#E6E4DF",
    "textMuted": "#B9BCC0",
    "textSubtle": "#8B8F94",
    "textFaint": "#7E8288",
    "primary": "#F2A900",
    "onPrimary": "#0B0C0D",
    "accent": "#F2A900",
    "highlight": "#F2A900",
    "onHighlight": "#0B0C0D",
    "danger": "#FF6B5B",
    "disabled": "#2A2E33"
  },
  "font": {
    "display": "IBM Plex Sans Condensed",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono"
  },
  "type": {
