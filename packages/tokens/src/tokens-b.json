    "button": {
      "font": "mono",
      "weight": 600,
      "size": 14,
      "lineHeight": 1.2,
      "letterSpacing": 1,
      "case": "upper"
    },
    "legal": {
      "font": "mono",
      "weight": 400,
      "size": 10,
      "lineHeight": 1.5,
      "case": "upper"
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "xxl": 28
  },
  "radius": {
    "chip": 4,
    "button": 4,
    "card": 4,
    "hero": 4,
    "avatar": 999
